<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Editor/Layout/LevelPainter/LevelPainterWindow.uss"/>
    <ui:VisualElement name="Root" data-source-type="LevelPainterSession, Assembly-CSharp-Editor" style="flex-grow: 1; padding-left: 4px; padding-right: 4px; padding-top: 4px; padding-bottom: 4px;">
        <ui:DropdownField label="Palette" style="margin-bottom: 4px;">
            <Bindings>
                <ui:DataBinding property="choices" data-source-path="Palettes" binding-mode="TwoWay"/>
                <ui:DataBinding property="index" data-source-path="SelectedPaletteIndex" binding-mode="TwoWay"/>
            </Bindings>
        </ui:DropdownField>
        <ui:ToggleButtonGroup label="Mode" value="01" name="Actions" style="margin-bottom: 4px;">
            <ui:Button text="Paint" name="Button" style="flex-grow: 1;"/>
            <ui:Button text="Erase" style="flex-grow: 1;"/>
            <ui:Button text="Replace" style="flex-grow: 1;"/>
            <Bindings>
                <ui:DataBinding property="value" data-source-path="ModeState" binding-mode="TwoWay"/>
            </Bindings>
        </ui:ToggleButtonGroup>
        <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 4px;">
            <ui:Toggle label="Snap" value="true" toggle-on-label-click="true" name="Toggle" style="flex-grow: 1; flex-shrink: 1; flex-direction: row; flex-wrap: nowrap;">
                <Bindings>
                    <ui:DataBinding property="value" data-source-path="SnapToGrid" binding-mode="TwoWay"/>
                </Bindings>
            </ui:Toggle>
            <ui:Toggle label="Normal" value="false" style="flex-grow: 1; flex-shrink: 1;">
                <Bindings>
                    <ui:DataBinding property="value" data-source-path="AlignToNormal" binding-mode="TwoWay"/>
                </Bindings>
            </ui:Toggle>
        </ui:VisualElement>
        <ui:SliderInt label="Z Layer" value="0" fill="false" name="LayerSlider" show-input-field="true" low-value="-10" high-value="10" style="margin-bottom: 4px;">
            <Bindings>
                <ui:DataBinding property="value" binding-mode="TwoWay" data-source-path="ZLayer"/>
            </Bindings>
        </ui:SliderInt>
        <ui:SliderInt label="Rotation" value="0" fill="false" show-input-field="true" low-value="0" high-value="270" style="margin-bottom: 4px;">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="Rotation" binding-mode="TwoWay"/>
            </Bindings>
        </ui:SliderInt>
        <ui:TextField label="Search" name="SearchField" placeholder-text="Filter by name..." style="margin-bottom: 4px;">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="SearchFilter" binding-mode="TwoWay"/>
            </Bindings>
        </ui:TextField>
        <ui:ListView name="Items" item-template="project://database/Assets/Editor/Layout/LevelPainter/LevelPainterPaletteDisplayItem.uxml" allow-add="false" allow-remove="false" binding-source-selection-mode="AutoAssign" virtualization-method="FixedHeight" fixed-item-height="50" style="flex-grow: 1; min-height: 100px; background-color: rgba(0, 0, 0, 0.12);">
            <Bindings>
                <ui:DataBinding property="itemsSource" data-source-path="Items"/>
                <ui:DataBinding property="selectedIndex" data-source-path="SelectedItemIndex"/>
            </Bindings>
        </ui:ListView>
    </ui:VisualElement>
</ui:UXML>
